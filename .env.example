# Sao chép file này thành `.env` rồi sửa. Mọi biến đều tùy chọn (đã có giá trị mặc định).

# --- Model ---
RAG_LLM_MODEL=llama3.2:3b
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_NUM_CTX=4096
RAG_TEMPERATURE=0

# --- Dữ liệu (đường dẫn tương đối được hiểu so với thư mục gốc dự án) ---
RAG_PAPERS_DIR=papers
RAG_INDEX_DIR=.index

# --- Chunking (đổi các giá trị này sẽ tự dựng lại index) ---
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# --- Retrieval ---
RAG_TOP_K=5
# Ngưỡng cosine similarity, dưới ngưỡng => "không tìm thấy thông tin"
RAG_SCORE_THRESHOLD=0.50
RAG_SOURCE_SCORE_MARGIN=0.08

# DEBUG | INFO | WARNING | ERROR
RAG_LOG_LEVEL=INFO
