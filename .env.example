# Sao chép file này thành `.env` rồi sửa. Mọi biến đều tùy chọn (giá trị dưới đây là mặc định).

# --- Model ---
RAG_LLM_MODEL=qwen2.5:7b-instruct
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_NUM_CTX=4096
RAG_TEMPERATURE=0

# --- Dữ liệu (đường dẫn tương đối được hiểu so với thư mục gốc dự án) ---
RAG_PAPERS_DIR=papers
RAG_INDEX_DIR=.index

# --- Chunking: section (tách theo mục "1., 2., ...") | fixed (cắt theo độ dài) ---
# Đổi các giá trị chunking/embedding sẽ tự dựng lại index.
RAG_CHUNKING=section
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# --- Retrieval: dense (vector) | hybrid (vector + BM25 bỏ dấu, gộp bằng RRF) ---
RAG_RETRIEVAL_MODE=hybrid
# Số ứng viên lấy từ mỗi nhánh trước khi rerank
RAG_FETCH_K=10
RAG_TOP_K=5

# Reranker cross-encoder (~2GB, tải lần đầu). Để trống để tắt: khi đó ngưỡng cosine bên dưới được dùng.
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Ngưỡng điểm reranker [0, 1]; dưới ngưỡng => "không tìm thấy thông tin"
RAG_RERANK_THRESHOLD=0.20
# Ngưỡng cosine similarity, chỉ dùng khi RAG_RERANK_MODEL để trống
RAG_SCORE_THRESHOLD=0.50
RAG_SOURCE_SCORE_MARGIN=0.08

# --- Hội thoại ---
# Viết lại câu hỏi nối tiếp / không dấu thành câu độc lập, có dấu (tốn thêm 1 lượt gọi LLM khi cần)
RAG_REWRITE_QUERIES=true
# Số lượt hỏi-đáp gần nhất được giữ làm ngữ cảnh
RAG_MAX_HISTORY_TURNS=6

# --- API ---
# Để trống = không yêu cầu khóa. Đặt giá trị thì /chat và /chat/stream cần header X-API-Key.
RAG_API_KEY=

# DEBUG | INFO | WARNING | ERROR
RAG_LOG_LEVEL=INFO
